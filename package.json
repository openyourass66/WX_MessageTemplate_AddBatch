{
  "name": "wechat-miniapp-template-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "export:templates": "node scripts/export-miniapp-templates.mjs",
    "add:templates": "node scripts/add-templates-to-miniapps.mjs",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.wechat.miniapp-template-tools",
    "productName": "微信小程序模板批量工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "scripts/**/*.mjs",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "微信小程序模板批量工具"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
