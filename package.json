{
  "name": "wechat-miniapp-template-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "export:templates": "node scripts/export-miniapp-templates.mjs",
    "add:templates": "node scripts/add-templates-to-miniapps.mjs",
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "pack": "electron-packager . \"微信小程序模板批量工具\" --platform=win32 --arch=x64 --out=release --overwrite --no-prune",
    "pack:min": "electron-packager . \"微信小程序模板批量工具\" --platform=win32 --arch=x64 --out=release --overwrite --prune"
  },
  "build": {
    "appId": "com.wechat.miniapp-template-tools",
    "productName": "微信小程序模板批量工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "scripts/**/*.mjs",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "微信小程序模板批量工具"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
